# Copy to .env.connected and fill on the deployment host.
SOBATNIRA_MODE=connected
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AI_BASE_URL=http://127.0.0.1:8000
OCR_MEDIA_BASE_URL=http://127.0.0.1:3000
DOCUMENT_WORKER_ENABLED=true
AI_SERVICE_INTERNAL_TOKEN=
WHATSAPP_ADAPTER_INTERNAL_TOKEN=
# PostgreSQL defaults to verified TLS on remote hosts.
DATABASE_URL=
DATABASE_SSL_CA_FILE=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Keep all public access disabled for this dedicated bucket.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional previous public hostname for the synthetic privacy probe.
R2_PUBLIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=
OPENROUTER_AGENT_FALLBACK_MODEL=
OPENROUTER_ALLOWED_PROVIDERS=
SOBATNIRA_API_URL=http://127.0.0.1:3000
SOBATNIRA_WHATSAPP_ACCOUNT_ID=sobatnira
# Provisioning and read-only scope verification.
SETUP_FACTORY_ID=
SETUP_OPERATOR_PHONE=
SETUP_OPERATOR_NAME=
SETUP_ADMIN_USER_ID=
SETUP_OWNER_USER_ID=
