{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sobatnira.local/schemas/whatsapp-inbound-event.schema.json",
  "title": "SobatNira Baileys Inbound Event",
  "type": "object",
  "required": [
    "provider",
    "provider_message_id",
    "chat_id",
    "sender_phone_e164",
    "provider_timestamp",
    "message_type"
  ],
  "properties": {
    "provider": {
      "const": "BAILEYS"
    },
    "provider_message_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_id": {
      "type": "string",
      "minLength": 1
    },
    "sender_phone_e164": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "quoted_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "caption": {
      "type": [
        "string",
        "null"
      ]
    },
    "message_type": {
      "enum": [
        "IMAGE",
        "TEXT",
        "DOCUMENT",
        "VIDEO",
        "OTHER"
      ]
    },
    "provider_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "media_mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_file_name": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
