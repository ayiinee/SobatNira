{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sobatnira.local/schemas/extraction-envelope.schema.json",
  "title": "SobatNira OCR Extraction Envelope",
  "type": "object",
  "required": [
    "request_id",
    "document_id",
    "submission_id",
    "revision_id",
    "status",
    "document_type",
    "schema_version",
    "source_asset_id",
    "extraction",
    "issues",
    "processing"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "NEEDS_REVIEW",
        "FAILED"
      ]
    },
    "document_type": {
      "enum": [
        "TRUCK_ARRIVAL_NOTE",
        "PRODUCTION_NOTE",
        "UNKNOWN"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "template_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_asset_id": {
      "type": "string"
    },
    "extraction": {
      "type": [
        "object",
        "null"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "processing": {
      "type": "object",
      "required": [
        "ocr_engine",
        "started_at",
        "duration_ms"
      ],
      "properties": {
        "ocr_engine": {
          "type": "string"
        },
        "ocr_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "vision_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "vision_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "media_duration_ms": { "type": "integer", "minimum": 0 },
        "infer_parse_duration_ms": { "type": "integer", "minimum": 0 },
        "reread_attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "reread_duration_ms": { "type": "integer", "minimum": 0 },
        "token_usage": {
          "type": [
            "object",
            "null"
          ]
        },
        "estimated_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
