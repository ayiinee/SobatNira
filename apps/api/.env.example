# Runtime lokal
APP_NAME=SobatNira API
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
FRONTEND_ORIGIN=http://127.0.0.1:8080
AI_BASE_URL=http://127.0.0.1:8000
DATA_MODE=fixture
DEFAULT_PRODUCTION_CONFIG_ID=
DEFAULT_PRICE_VERSION_ID=

# Supabase / PostgreSQL
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
DATABASE_URL=
DB_POOL_BUSINESS_MAX=5
DB_POOL_DOCUMENTS_MAX=5
DB_POOL_IDLE_MS=30000
DB_POOL_CONNECT_MS=8000
DB_STATEMENT_TIMEOUT_MS=8000
# Opsional: MAX=2000 mengurangi polling idle dengan tambahan delay sampai 2 detik.
DOCUMENT_POLL_MIN_MS=500
DOCUMENT_POLL_MAX_MS=500

# Redis
REDIS_URL=
CATALOG_CACHE_ENABLED=false
CATALOG_CACHE_TTL_SECONDS=300
CATALOG_CACHE_TIMEOUT_MS=100

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCOUNT_ID=
# Wajib saat REPORT_EXPORT_ENABLED=true pada production/connected.
R2_PUBLIC_BASE_URL=
R2_REGION=
R2_SIGNED_URL_TTL_SECONDS=900

# Explicit opt-in for owner sessions in the OpenClaw adapter and export jobs
OWNER_AGENT_ENABLED=false
REPORT_EXPORT_ENABLED=false
# Enable after connected clients that edit lot costs send a version.
LOT_COST_REQUIRE_VERSION=false
# Leave disabled until the staging Supabase invitation redirect is allowed and verified.
FACTORY_ADMIN_INVITES_ENABLED=false
SUPABASE_ADMIN_INVITE_REDIRECT_URL=
