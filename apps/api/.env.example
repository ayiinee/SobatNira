# Runtime lokal
APP_NAME=SobatNira API
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
FRONTEND_ORIGIN=http://127.0.0.1:8080
AI_BASE_URL=http://127.0.0.1:8000
DATA_MODE=fixture
DEFAULT_PRODUCTION_CONFIG_ID=
DEFAULT_PRICE_VERSION_ID=

# Supabase / PostgreSQL
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
DATABASE_URL=

# Redis
REDIS_URL=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=
R2_REGION=
R2_SIGNED_URL_TTL_SECONDS=900

# Explicit opt-in for owner sessions in the OpenClaw adapter and export jobs
OWNER_AGENT_ENABLED=false
REPORT_EXPORT_ENABLED=false
