{
  "name": "@sobatnira/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "seed:calculations": "npm run build --silent && node scripts/seed-calculations.cjs",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "check:connections": "npm run build && node dist/connections/check-connections.js",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "db:seed:demo": "npm run build && node scripts/seed-demo.mjs",
    "test:access-db": "npm run build && node --test test/integration/access-database.test.cjs",
    "test:production-db": "npm run build && node --test test/integration/production-database.test.cjs",
    "test:intake-db": "npm run build && node --test test/integration/intake-database.test.cjs",
    "test:milling-db": "npm run build && node --test test/integration/milling-database.test.cjs",
    "test:juice-db": "npm run build && node --test test/integration/juice-database.test.cjs",
    "test:evidence-db": "npm run build && node --test test/integration/evidence-database.test.cjs",
    "test:evidence-r2": "npm run build && node --test test/integration/evidence-r2.test.cjs",
    "db:migrate:ocr": "npm run build && node --env-file-if-exists=../../.env dist/documents/migrate.js",
    "local:stack": "npm run build && node scripts/local-stack.mjs",
    "seed:production": "npm run build --silent && node scripts/seed-production.cjs",
    "seed:flutter-demo": "npm run build --silent && node scripts/seed-flutter-demo.cjs",
    "test:batches-db": "npm run build && node --test test/integration/batches-database.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "exceljs": "4.4.0",
    "ioredis": "6.0.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
