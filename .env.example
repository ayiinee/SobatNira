# Aplikasi
APP_NAME=SobatNira
NODE_ENV=development
LOG_LEVEL=debug

# NestJS
API_HOST=127.0.0.1
API_PORT=3000

# Flutter web
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# FastAPI internal
AI_BASE_URL=http://127.0.0.1:8000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Isi jika backend membutuhkan operasi administratif Supabase
SUPABASE_SECRET_KEY=

# PostgreSQL: ambil connection string dari Supabase
DATABASE_URL=

# Redis: contoh lokal, sesuaikan dengan provider
REDIS_URL=redis://127.0.0.1:6379

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sobatnira
R2_ENDPOINT=
R2_REGION=auto

# Usulan durasi akses sementara, dalam detik
R2_SIGNED_URL_TTL_SECONDS=300
# Batas waktu pemeriksaan koneksi (milidetik)
CONNECTION_TIMEOUT_MS=8000

# Opsional: CA PostgreSQL, path relatif terhadap akar repo atau absolut
DATABASE_SSL_CA_FILE=

# Batas waktu request draf AI, di bawah timeout Flutter demo
AI_TIMEOUT_MS=3000

# Opsional: URL r2.dev/domain lama untuk memastikan akses anonim DITOLAK. Bucket tetap wajib privat.
R2_PUBLIC_BASE_URL=
